{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|new|load",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/briefing.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/protocol.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ask_user_question|AskQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/ask-guard.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Task|spawn_subagent|Write|Edit|MultiEdit|write|search_replace|hashline_edit|StrReplace|Bash|run_terminal_command|run_terminal_cmd|Shell|Artifact|SendUserFile",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/protocol.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task|spawn_subagent|WebSearch|WebFetch|web_search|web_fetch|open_page|open_page_with_find|Write|Edit|MultiEdit|write|search_replace|hashline_edit|StrReplace|Bash|run_terminal_command|run_terminal_cmd|Shell|Read|read_file|hashline_read|Grep|grep|hashline_grep|Glob|list_dir",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/protocol.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/protocol.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/protocol.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/briefing.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "modules": ["./projects.tsx"]
}
